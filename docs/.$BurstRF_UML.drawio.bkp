          </mxGeometry>
        </mxCell>
        <mxCell id="qpp1i6JPxUIBGQLCngFS-21" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;SigMF Recording&lt;/h1&gt;&lt;p&gt;High-level interface with SigMF Data and Metadata. To generate a spectrogram of a SigMF dataset, you need to iterate over captures, loading as many as it takes to fill up the screen.&amp;nbsp; This means it needs to handle:&lt;/p&gt;&lt;p&gt;* the data type the data is written in.&lt;/p&gt;&lt;p&gt;* the offset specified in the globals - this is a absolute offset, as indices in captures will use this offset. This means you need to subtract this offset from sample_start to figure out the actual disk index.&lt;/p&gt;&lt;p&gt;* So to properly parse a capture, you need to handle:&lt;br&gt;&lt;/p&gt;&lt;ul&gt;&lt;li class=&quot;whitespace-normal break-words&quot;&gt;datatype (global)&lt;/li&gt;&lt;li class=&quot;whitespace-normal break-words&quot;&gt;offset (global)&lt;/li&gt;&lt;li class=&quot;whitespace-normal break-words&quot;&gt;num_channels (global)&lt;/li&gt;&lt;li class=&quot;whitespace-normal break-words&quot;&gt;trailing_bytes (global)&lt;/li&gt;&lt;li class=&quot;whitespace-normal break-words&quot;&gt;sample_start (capture)&lt;/li&gt;&lt;li class=&quot;whitespace-normal break-words&quot;&gt;global_index (capture)&lt;/li&gt;&lt;li class=&quot;whitespace-normal break-words&quot;&gt;header_bytes (capture)&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="390" width="340" x="950" y="-1720" as="geometry" />
        </mxCell>
        <mxCell id="qpp1i6JPxUIBGQLCngFS-22" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" value="SigMFCollection" vertex="1">
          <mxGeometry height="164" width="460" x="-535" y="-1630" as="geometry" />
        </mxCell>
        <mxCell id="qpp1i6JPxUIBGQLCngFS-23" parent="qpp1i6JPxUIBGQLCngFS-22" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" value="+ metaFilePath: std::string" vertex="1">
          <mxGeometry height="26" width="460" y="26" as="geometry" />
        </mxCell>
        <mxCell id="qpp1i6JPxUIBGQLCngFS-24" parent="qpp1i6JPxUIBGQLCngFS-22" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" value="+ version: std::string" vertex="1">
          <mxGeometry height="26" width="460" y="52" as="geometry" />
        </mxCell>
        <mxCell id="qpp1i6JPxUIBGQLCngFS-25" parent="qpp1i6JPxUIBGQLCngFS-22" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" value="+ metadataOnly: boolean" vertex="1">
          <mxGeometry height="26" width="460" y="78" as="geometry" />
        </mxCell>
        <mxCell id="qpp1i6JPxUIBGQLCngFS-26" parent="qpp1i6JPxUIBGQLCngFS-22" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" value="" vertex="1">
          <mxGeometry height="8" width="460" y="104" as="geometry" />
        </mxCell>
        <mxCell id="qpp1i6JPxUIBGQLCngFS-27" parent="qpp1i6JPxUIBGQLCngFS-22" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" value="+ SigMFDatasetHandler(std::string metaFilePath)" vertex="1">
          <mxGeometry height="26" width="460" y="112" as="geometry" />
        </mxCell>
        <mxCell id="qpp1i6JPxUIBGQLCngFS-28" parent="qpp1i6JPxUIBGQLCngFS-22" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" value="+ method(type): type" vertex="1">
          <mxGeometry height="26" width="460" y="138" as="geometry" />
        </mxCell>
        <mxCell id="qpp1i6JPxUIBGQLCngFS-32" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="Question: How to handle different center frequencies across chunks in a file? For the spectrogram view? Should I... make tabs for each center frequency? Try to plot it all as one big spectrogram?&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Potentially simplest, while still being complete:&lt;/div&gt;&lt;div&gt;* allow user to pick the center frequency out of the set of possible center frequencies, then only render the captures that are at that center frequency.&lt;/div&gt;&lt;div&gt;NOTE: still doesn&#39;t handle num_channels -&amp;gt; potentially multiple parallel data streams... simplest complete solution may be to also allow the user to select the channel from the list of channels as well as a list of center frequencies...&lt;/div&gt;" vertex="1">
          <mxGeometry height="156" width="460" x="480" y="-480" as="geometry" />
        </mxCell>
        <mxCell id="xhd_DwO9SQiEmucfImrC-2" edge="1" parent="1" source="qpp1i6JPxUIBGQLCngFS-33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="qpp1i6JPxUIBGQLCngFS-35" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qpp1i6JPxUIBGQLCngFS-33" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;NOTE: Need to make a default error message for user for when anything goes wrong...&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;NOTE: use offset to convert annotation indices to actual file indices (for SigMF Collection Support).&lt;/div&gt;&lt;div&gt;NOTE: Must also use Capture header_bytes to offset reading from the file - we will need to skip over the header bytes when requesting that the SigMF Dataset give us samples.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;NOTE: A SigMFDataset object can&#39;t know the exact number of samples in the dataset without the SigMFMetadata. This is because Captures could have header_bytes, which means we need to iterate over all of the captures and check for header bytes before we can identify if we need to exclude bytes from the total sample count (fileSize - sumHeaderBytes).&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="420" x="-425" y="-400" as="geometry" />
        </mxCell>
        <mxCell id="qpp1i6JPxUIBGQLCngFS-34" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;WorkFlow&lt;/h1&gt;&lt;p&gt;1. View determines number of samples you need, total.&lt;/p&gt;&lt;p&gt;2. SigMFDatasetHandler parses that to X captures, rounding up.&lt;/p&gt;&lt;p&gt;3. X Captures are loaded as spectrogram chunks, which are images that you can stack top to bottom. These account for all of the different values that effect what data is on disk and how it affects the spectrogram fft rows in terms of time (gaps between captures).&lt;/p&gt;&lt;p&gt;4. These spectrogram chunks are assigned a channel and a center frequency.&lt;/p&gt;&lt;p&gt;5. The view picks a channel and center frequency to display.&lt;/p&gt;" vertex="1">
          <mxGeometry height="244" width="460" x="1020" y="-460" as="geometry" />
        </mxCell>
        <mxCell id="qpp1i6JPxUIBGQLCngFS-35" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Thoughts&lt;/h1&gt;&lt;p&gt;SpectrogramGenerator lives at the SigMFDatasetHandler level. It handles a single channel at a time. SigMFDatasetHandler picks a set of captures to generate, tells SpectrogramGenerator what the details are (sample rate, channel, etc) and builds spectrogram chunks appropriately.&lt;/p&gt;&lt;p&gt;This means the SigMFDatasetHandler manages the chunks as groups that can be displayed by the frontend - the user pick a center frequency and sample rate, then the SigMFDatasetHandler takes care of presenting that group of captures/chunks based on the viewport parameters &amp;amp; user scroll location.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;NOTE: Check all numeric types have the correct size to meet the SigMF standard!!!&lt;/p&gt;" vertex="1">
          <mxGeometry height="300" width="350" x="140" y="-430" as="geometry" />
        </mxCell>
        <mxCell id="oMZ1Cc9395TJkZhv5qda-3" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;SigMF Collections&lt;/h1&gt;&lt;p&gt;SigMF Recordings are built&amp;nbsp;with the possibility that they exist within a SigMF Collection. The idea is that you have distinct, fixed-sized SigMF Recordings that exist within a larger data stream (SigMF Collection). The practical implication of this is that SigMF Datasets&lt;/p&gt;" vertex="1">
          <mxGeometry height="210" width="460" x="1660" y="-1890" as="geometry" />
        </mxCell>
        <mxCell id="O1l0729uWP5XVa7aK2IS-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;SigMF Standards Notes&lt;/h1&gt;&lt;p&gt;SigMF Dataset - the .sigmf-data file, corresponds to raw RF data (real or complex) sitting in a file.&lt;/p&gt;&lt;p&gt;SigMF Metadata - the .sigmf-meta file, corresponds to the metadata that describes what data is in the .sigmf-data file.&lt;/p&gt;&lt;p&gt;SigMF Recording - both a .sigmf-meta and .sigmf-data file pair, grouped together to make an atomic unit of RF data that can be interpreted by a program.&lt;/p&gt;&lt;p&gt;SigMF Collection - a method of interpreting a stream of RF data across multiple SigMF Recordings, primarily effecting the absolute indices that refer to the RF data in each file (the indices in each .sigmf-meta file refer to the same global index space as the collection. The .sigmf-data files are refered to as one continuous stream, not individual files).&lt;/p&gt;&lt;p&gt;SigMF Archive - a compressed SigMF Recording or SigMF Collection.&lt;/p&gt;" vertex="1">
          <mxGeometry height="320" width="520" x="1540" y="-2270" as="geometry" />
        </mxCell>
        <mxCell id="xhd_DwO9SQiEmucfImrC-3" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Error Handling&lt;/h1&gt;&lt;p&gt;As the current implementation of the SigMF library uses RAII, and will crash on construction given invalid data, we must provide robust error messages to help the user identify which SigMF rule has been broken &amp;amp; resolve it.&lt;/p&gt;&lt;p&gt;* Need to use the SigMF Metadata support as much as possible (ie. libsigmf).&lt;/p&gt;&lt;p&gt;* Need to reference good error handling/msgs from the sigmf-python repo - if they&#39;re handling the errors, so should I...&lt;/p&gt;" vertex="1">
          <mxGeometry height="210" width="350" x="-2390" y="-2540" as="geometry" />
        </mxCell>
        <mxCell id="xhd_DwO9SQiEmucfImrC-15" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;SigMF-IO&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px; margin-bottom: 10.08px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px; font-weight: normal;&quot;&gt;The purpose of sigmf-io is to support File I/O + Metadata for SigMF Datasets, Metadata, Recordings, Collections, and Archives. This means the primary responsibilities are:&lt;/span&gt;&lt;/h1&gt;&lt;p&gt;* Completeness - Implement a complete API Interface to interact with SigMF data, encompassing the total standard - Both Conforming and Non-Conforming&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;SigMF Datasets, Metadata, Recordings, Collections, and Archives.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;* Correctness - implement valid interfaces for the SigMF standard. Support the developer with detailed Error Handling for ease of use.&lt;/p&gt;&lt;p&gt;Secondary focuses include:&lt;/p&gt;&lt;p&gt;* Optimizing for speed.&lt;/p&gt;&lt;p&gt;* Supporting documentation for the API to make integration simple.&lt;/p&gt;&lt;p&gt;* Detailed error messages to help with parsing and construction of SigMF objects.&lt;/p&gt;&lt;p&gt;* Wrappers for integrating into other languages.&lt;/p&gt;" vertex="1">
          <mxGeometry height="440" width="370" x="-2280" y="-800" as="geometry" />
        </mxCell>
        <mxCell id="xhd_DwO9SQiEmucfImrC-17" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;SigMF DataType (And Enumerations)&lt;/h1&gt;&lt;p&gt;&amp;nbsp;The SigMFDataType, along with supporthing enumerations, are made to encapsulate the variability of the different data types that can appear in a SigMFDataset. SigMF supports:&lt;/p&gt;&lt;p&gt;* complex or real signal data (sample format)&lt;/p&gt;&lt;p&gt;* little endian or big endian data (endianness)&lt;/p&gt;&lt;p&gt;* various primitives (float 32 &amp;amp; 64, int 16 &amp;amp; 32, uint 16 &amp;amp; 32, byte &amp;amp; ubyte) (sample type/primitive type)&lt;/p&gt;&lt;p&gt;Because of this, interpreting the data on disk becomes non-trivial and error prone when supporting all of the ways data can be written to disk that SigMF supports. When reading data from disk, we need a few capabilities, such as knowing the sample format, sample (primitive) type, the endianness, the number of bytes in each primitive, and the number of primitives that make up a sample. With this information wrapped in a convenient interface, we can begin the process of loading data from disk.&lt;/p&gt;" vertex="1">
          <mxGeometry height="247.5" width="660" x="-3090" y="-760" as="geometry" />
        </mxCell>
        <mxCell id="xhd_DwO9SQiEmucfImrC-18" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;SigMF Dataset&lt;/h1&gt;&lt;p&gt;A SigMF Dataset represents the data file on disk, and encapsulates the file I/O needed to get RF samples. As SigMF Metadata is &lt;i&gt;heavily &lt;/i&gt;coupled to an individual&#39;s ability to load SigMF Datasets (as the SigMF Dataset requires information from SigMF Metadata to load any data), these two classes are tightly coupled in the form of a SigMF Recording object. The main reasons to separate the two are:&lt;/p&gt;&lt;p&gt;* To keep File I/O abstracted away from the messy process of working with metadata (in support of the work to provide samples to the user in a convenient manner).&lt;/p&gt;&lt;p&gt;* To allow a user, if they want/must, the ability to interact with a SigMFDataset file at a lower level without using the corresponding metadata file (ie. you provide the bare-minimum metadata needed to read data from disk).&lt;/p&gt;&lt;p&gt;TODO:&lt;/p&gt;&lt;p&gt;* Implement header_bytes &amp;amp; trailing bytes reading properly.&lt;/p&gt;&lt;p&gt;* Implement all possible convenience functions that the user may need, and document the assumptions made that each convenience function assumes (ex: channel index, number of samples, if there are or not header bytes, etc).&lt;/p&gt;" vertex="1">
          <mxGeometry height="330" width="650" x="-1840" y="-590" as="geometry" />
        </mxCell>
        <mxCell id="xhd_DwO9SQiEmucfImrC-19" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" value="SigMFSpecEnforcementVisitor" vertex="1">
