        <mxCell id="qkVBq6RJds2DqXQby8u5-6" parent="qkVBq6RJds2DqXQby8u5-45" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="CH 1&lt;div&gt;Index 1&lt;/div&gt;" vertex="1">
