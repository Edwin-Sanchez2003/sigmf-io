        <mxCell id="phDoIGZZoSWocM0jI48h-25" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="These are closer to compound structs and should probably be handled similarly to Captures, Annotaitons, etc as form can vary based on what the user decides to put in there... meaning it might be closer to arbitrary JSON objects that get some sort of validation applied than to actual data types themselves." vertex="1">
          <mxGeometry height="200" width="150" x="-1020" y="-2580" as="geometry" />
        </mxCell>
        <mxCell id="8nr05T6UOH9qvmAxOsa1-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="What I&#39;m leaning towards:&lt;div&gt;* Make classes for users to read &amp;amp; write datasets, to enforce formatting?&lt;/div&gt;&lt;div&gt;* When reading a SigMF file, defer to constructor to build each field (especially when they follow some sort of pattern), and use logic as dictated by the spec to pick values given certain circumstances.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Make constructing a SigMFMetadata object via a constructor w/ a file path, forcing data loading &amp;amp; validation at construction time.&lt;/div&gt;&lt;div&gt;-&amp;gt; Same issue as before - how do we handle data that&#39;s in-between when building a dataset? May need structs back later...&lt;/div&gt;" vertex="1">
          <mxGeometry height="213" width="460" x="-370" y="-2743.5" as="geometry" />
        </mxCell>
        <mxCell id="WylAUdubsWu8hRcYI3EU-2" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" value="JSONSctructureBase" vertex="1">
          <mxGeometry height="86" width="460" x="-170" y="-2510" as="geometry" />
        </mxCell>
        <mxCell id="WylAUdubsWu8hRcYI3EU-3" parent="WylAUdubsWu8hRcYI3EU-2" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" value="+ field: type" vertex="1">
          <mxGeometry height="26" width="460" y="26" as="geometry" />
        </mxCell>
        <mxCell id="WylAUdubsWu8hRcYI3EU-6" parent="WylAUdubsWu8hRcYI3EU-2" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" value="" vertex="1">
          <mxGeometry height="8" width="460" y="52" as="geometry" />
        </mxCell>
        <mxCell id="WylAUdubsWu8hRcYI3EU-8" parent="WylAUdubsWu8hRcYI3EU-2" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" value="+ method(type): type" vertex="1">
          <mxGeometry height="26" width="460" y="60" as="geometry" />
        </mxCell>
        <mxCell id="WylAUdubsWu8hRcYI3EU-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="* JSONStructureBase encapsulates the common implementation of a SigMF Schema component represented in JSON. This is the base class for metadata components." vertex="1">
          <mxGeometry height="134" width="290" x="640" y="-2504" as="geometry" />
        </mxCell>
        <mxCell id="WylAUdubsWu8hRcYI3EU-12" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Control Flow&lt;/h1&gt;&lt;p&gt;1. Point SigMFRecording object at a file path, a jsoncons object, or with the default initializer. User specifies the strictness of the schema validation.&lt;/p&gt;&lt;p&gt;2. If initialized with on-disk data, then schema validation happens (depending on user specified strictness).&lt;/p&gt;&lt;p&gt;3. Afterwards, user can use the object to read and write data to the object.&lt;/p&gt;&lt;p&gt;4. Once written, the user can call a function to serialize the changes/new dataset.&lt;/p&gt;" vertex="1">
          <mxGeometry height="220" width="370" x="-130" y="-2300" as="geometry" />
        </mxCell>
