        </mxCell>
        <mxCell id="_5YiugN58uN8odfge-gd-25" parent="xhd_DwO9SQiEmucfImrC-19" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" value="+ validate(const std::vector&amp;lt;const SigMFAnnotation&amp;amp;&amp;gt;): SigMFValidationResult" vertex="1">
          <mxGeometry height="26" width="650" y="242" as="geometry" />
        </mxCell>
        <mxCell id="_5YiugN58uN8odfge-gd-23" parent="xhd_DwO9SQiEmucfImrC-19" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" value="+ validate(...): SigMFValidationResult&amp;nbsp;// new validate for each individual field, per spec regulations." vertex="1">
          <mxGeometry height="26" width="650" y="268" as="geometry" />
        </mxCell>
        <mxCell id="xhd_DwO9SQiEmucfImrC-28" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;SigMF Spec Enforcement Visitor&lt;/h1&gt;&lt;p&gt;Visits a SigMF Dataset, Metatadata, Capture, Annotation, Global, and/or Collection, validating that the fields meet the SigMF specification.&lt;/p&gt;&lt;p&gt;NOTE: Should be versioned to support/enforce based on a specific version of SigMF. (This can be done through overriding functions via inheritance).&lt;/p&gt;&lt;p&gt;Currently two approaches:&lt;/p&gt;&lt;p&gt;* Custom classes for data requiring parsing (ie. UUID, SigMFDataType, etc.)&lt;/p&gt;&lt;p&gt;* Visitor function for anything that requires a simple range-check (sample rate, etc.)&lt;/p&gt;&lt;p&gt;-&amp;gt; no explosion of arbitrary data type classes, but good enforcement of behavior for complex data types.&lt;/p&gt;" vertex="1">
          <mxGeometry height="250" width="460" x="1130" y="-2940" as="geometry" />
        </mxCell>
        <mxCell id="xhd_DwO9SQiEmucfImrC-30" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" value="Key" vertex="1">
          <mxGeometry height="78" width="280" x="-1400" y="-2520" as="geometry" />
        </mxCell>
