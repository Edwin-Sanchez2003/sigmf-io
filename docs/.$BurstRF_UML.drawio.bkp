        </mxCell>
        <mxCell id="qkVBq6RJds2DqXQby8u5-7" parent="qkVBq6RJds2DqXQby8u5-45" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="CH 2&lt;div&gt;Index 1&lt;/div&gt;" vertex="1">
