        <mxCell id="HEY7IZIS7RxNxtXOzFUf-92" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;h1&gt;SigMF Fields - High Importance&lt;/h1&gt;&lt;div&gt;&lt;h2&gt;&lt;u&gt;REQUIRED&lt;/u&gt;&lt;/h2&gt;&lt;h3&gt;Global&lt;/h3&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- core:datatype&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- core:version&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- core:offset (only necessary for mapping a file in a SigMF Collection; ie. ordering a stream of data stored in fixed-sized files).&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- core:num_channels&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- core:trailing_bytes&lt;br&gt;&lt;/div&gt;&lt;h3&gt;Captures&lt;/h3&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- core:sample_start&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- core:header_bytes&lt;br&gt;&lt;/div&gt;&lt;h2&gt;&lt;u&gt;Recommended&lt;/u&gt;&lt;/h2&gt;&lt;h3&gt;Global&lt;/h3&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- core:sample_rate&lt;br&gt;&lt;/div&gt;&lt;h3&gt;Captures&lt;/h3&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- core:frequency&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
