        </mxCell>
        <mxCell id="qkVBq6RJds2DqXQby8u5-8" parent="qkVBq6RJds2DqXQby8u5-45" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;legacyAnchorPoints=0;rotation=-90;" value="" vertex="1">
          <mxGeometry height="205" width="20" x="510" y="192" as="geometry" />
        </mxCell>
        <mxCell id="qkVBq6RJds2DqXQby8u5-9" parent="qkVBq6RJds2DqXQby8u5-45" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Frame 0" vertex="1">
          <mxGeometry height="30" width="60" x="490" y="256" as="geometry" />
        </mxCell>
        <mxCell id="qkVBq6RJds2DqXQby8u5-10" parent="qkVBq6RJds2DqXQby8u5-45" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;legacyAnchorPoints=0;rotation=-90;" value="" vertex="1">
          <mxGeometry height="205" width="20" x="720" y="192" as="geometry" />
        </mxCell>
        <mxCell id="qkVBq6RJds2DqXQby8u5-11" parent="qkVBq6RJds2DqXQby8u5-45" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Frame 1" vertex="1">
          <mxGeometry height="30" width="60" x="700" y="256" as="geometry" />
        </mxCell>
        <mxCell id="qkVBq6RJds2DqXQby8u5-12" parent="qkVBq6RJds2DqXQby8u5-45" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Frame Examples&lt;/h1&gt;&lt;p&gt;The &quot;frame&quot; concept is made up to express the grouping of all of the samples that correspond to a single index, but across all channels in a dataset.&lt;/p&gt;&lt;p&gt;If a dataset has only 1 channel, then a frame is equivalent to a single sample from that channel at the given index (frame loses its meaning).&lt;/p&gt;&lt;p&gt;For channel counts greater than 1, a frame indicates a group of samples at the same index. The location of the sample within the frame corresponds to which channel it belongs to.&lt;/p&gt;" vertex="1">
          <mxGeometry height="236" width="260" x="80" y="212" as="geometry" />
        </mxCell>
